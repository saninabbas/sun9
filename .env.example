# ============================================================
# sun9 Public SaaS Platform - Production Environment
# ============================================================

# Domains & SSL
SUN9_DOMAIN=app.sun9.com
PORTAL_DOMAIN=sun9.com
SSL_EMAIL=admin@sun9.com

# PostgreSQL Database Configuration
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=sun9_db
DB_POSTGRESDB_USER=sun9_admin
DB_POSTGRESDB_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD_HERE

# Security & Secrets (32 characters random string)
SUN9_ENCRYPTION_KEY=YOUR_32_CHAR_RANDOM_SECRET_ENCRYPTION_KEY

# Polar.sh Merchant of Record (MoR) & Billing Keys
POLAR_ACCESS_TOKEN=polar_at_your_polar_access_token_here
POLAR_ORGANIZATION_ID=your_polar_organization_id_here
POLAR_WEBHOOK_SECRET=polar_whsec_your_webhook_signing_secret_here
POLAR_ENV=sandbox
POLAR_PRODUCT_PRO_MONTHLY=polar_prod_pro_monthly_id
POLAR_PRODUCT_PRO_ANNUAL=polar_prod_pro_annual_id
POLAR_PRODUCT_SCALE_MONTHLY=polar_prod_scale_monthly_id
POLAR_PRODUCT_SCALE_ANNUAL=polar_prod_scale_annual_id

# Transactional Email (Resend / SendGrid / Postmark)
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.resend.com
N8N_SMTP_PORT=465
N8N_SMTP_USER=resend
N8N_SMTP_PASS=re_your_api_key
N8N_SMTP_SENDER=noreply@sun9.com
